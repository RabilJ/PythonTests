import requests

url = "https://jsonplaceholder.typicode.com/comments?postId=1"

data = requests.get(url).json()

list1 = []
for item in data:
    list1.append(item['email'])

print(list1)

url2 = "https://jsonplaceholder.typicode.com/comments?postId=1"

emails = [item['email'] for item in requests.get(url2).json()] #list comprehension lub wyrażenie listowe

print(emails)

def fetch_emails(post_id: int):

    # Pobiera komentarze dla danego postu i zwraca listę emaili.
    # Zawiera obsługę błędów (brak internetu, timeout, zły status itd.)

    url = f"https://jsonplaceholder.typicode.com/comments?postId={post_id}"


    try:
        response = requests.get(url, timeout=1) #Zapytanie wykonało się za wolno
        response.raise_for_status()
    except requests.exceptions.Timeout:
        print("Request timed out")
        return []
    
    except requests.exceptions.ConnectionError: #Brak internetu
        print("No internet connection")
        return []
    
    except requests.exceptions.HTTPError as http_err:
        print(f" ! HTTP error occurred: {http_err}")
        return []
    
    except requests.exceptions.RequestException as err: #Ogólny error
        print(f" ! An error occurred: {err}")
        return []
    
    try:
        data = response.json()

    except ValueError:
        print(" ! Error parsing JSON")
        return []
    
    if not isinstance(data, list): #Gdy nie jest listą, np response nie kończy się na .json()
        print(" ! API response is not a list") 
        return []
    
    emails = [item.get('email') for item in data if isinstance(item, dict)]
    print(emails)


fetch_emails(1)