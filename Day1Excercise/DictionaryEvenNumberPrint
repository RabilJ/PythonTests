def dictionary_even_values_print(dictionary):
    for key in dictionary:
        if dictionary[key] % 2 == 0:
            print(f"Key: {key}, Value: {dictionary[key]} is even")
        else:
            print(f"Key: {key}, Value: {dictionary[key]} is uneven")

dictionary = {'a':1,'b':2,'c':3,'d':4,'e':5,'f':6,'g':7,'h':8,'i':9,'j':10}

dictionary_even_values_print(dictionary)